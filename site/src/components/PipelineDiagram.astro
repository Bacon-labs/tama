---
// Pipeline diagram: Verity source → proof → EVM bytecode.
// The manifest binds the proof to the bytecode by recording the same hash
// on both sides, so the bytes you deploy are the bytes the proof is about.
---

<figure class="pipe">
  <svg
    viewBox="0 0 760 240"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-labelledby="pipe-title pipe-desc"
  >
    <title id="pipe-title">Tama pipeline</title>
    <desc id="pipe-desc">
      Verity source flows through a Lean proof to deployable EVM bytecode.
      A manifest binds the proof and the bytecode by recording the same
      hash on both sides.
    </desc>

    <defs>
      <linearGradient id="line-jade" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#1f5f4f" stop-opacity="0.0" />
        <stop offset="0.05" stop-color="#1f5f4f" stop-opacity="0.7" />
        <stop offset="0.95" stop-color="#1f5f4f" stop-opacity="0.7" />
        <stop offset="1" stop-color="#1f5f4f" stop-opacity="0.0" />
      </linearGradient>
      <radialGradient id="node-jade" cx="0.5" cy="0.4" r="0.6">
        <stop offset="0" stop-color="#a4c5b8" />
        <stop offset="0.6" stop-color="#3d8073" />
        <stop offset="1" stop-color="#0c3a31" />
      </radialGradient>
      <radialGradient id="node-brass" cx="0.5" cy="0.4" r="0.6">
        <stop offset="0" stop-color="#e1c98e" />
        <stop offset="0.6" stop-color="#a78947" />
        <stop offset="1" stop-color="#5e4924" />
      </radialGradient>
    </defs>

    <text x="60" y="36" class="step-lbl">source</text>
    <text x="700" y="36" text-anchor="end" class="step-lbl">artifact</text>

    <line x1="40" y1="110" x2="720" y2="110" stroke="url(#line-jade)" stroke-width="1.6" />

    <g class="node" transform="translate(110,110)">
      <circle r="20" fill="url(#node-jade)" />
      <text y="-34" text-anchor="middle" class="lbl">Verity source</text>
      <text y="46" text-anchor="middle" class="sub">.lean</text>
    </g>
    <g class="node" transform="translate(380,110)">
      <circle r="20" fill="url(#node-brass)" />
      <text y="-34" text-anchor="middle" class="lbl">Proof</text>
      <text y="46" text-anchor="middle" class="sub">Lean checks</text>
    </g>
    <g class="node" transform="translate(650,110)">
      <circle r="20" fill="url(#node-jade)" />
      <text y="-34" text-anchor="middle" class="lbl">EVM bytecode</text>
      <text y="46" text-anchor="middle" class="sub">deployable</text>
    </g>

    <!-- Manifest tying proof to bytecode: same hash on both ends -->
    <path
      d="M 380 132 Q 515 200 650 132"
      fill="none"
      stroke="rgba(167,137,71,0.55)"
      stroke-width="1.2"
      stroke-dasharray="3 4"
    />
    <text x="515" y="218" text-anchor="middle" class="caption">
      manifest — same hash on both sides
    </text>
  </svg>
</figure>

<style>
  .pipe {
    margin: 0;
    width: 100%;
    padding: var(--s-5) 0;
  }
  .pipe svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .lbl {
    font-family: var(--font-display);
    font-size: 16px;
    fill: var(--ink);
    font-weight: 500;
  }
  .sub {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    fill: var(--ink-mute);
    text-transform: uppercase;
  }
  .caption {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 13px;
    fill: var(--jade-700);
  }
  .step-lbl {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    fill: var(--ink-mute);
  }

  @media (prefers-color-scheme: dark) {
    .lbl { fill: var(--ink); }
    .caption { fill: var(--jade-300); }
  }
</style>
