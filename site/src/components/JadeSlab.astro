---
// "Jade slab" — translucent layered card with a subtle inner light,
// used for feature explanations on the home page.
interface Props {
  kanji?: string;
  title: string;
  tone?: "jade" | "brass" | "ink";
}
const { kanji, title, tone = "jade" } = Astro.props;
---

<article class={`slab slab-${tone}`}>
  {kanji && (
    <span class="slab-kanji" aria-hidden="true">{kanji}</span>
  )}
  <h3>{title}</h3>
  <div class="slab-body"><slot /></div>
</article>

<style>
  .slab {
    position: relative;
    padding: var(--s-5) var(--s-5) var(--s-6);
    border-radius: var(--r-lg);
    background:
      linear-gradient(160deg,
        color-mix(in oklab, var(--jade-100) 45%, var(--washi-bright)) 0%,
        var(--washi-bright) 60%,
        color-mix(in oklab, var(--jade-100) 25%, var(--washi-bright)) 100%);
    border: 1px solid color-mix(in oklab, var(--jade-300) 40%, transparent);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.7),
      0 18px 40px -22px rgba(31, 95, 79, 0.35),
      0 1px 0 rgba(31, 95, 79, 0.06);
    overflow: hidden;
  }
  .slab::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      radial-gradient(220px 140px at 100% 0%, rgba(167,137,71,0.10), transparent 70%),
      radial-gradient(280px 200px at 0% 100%, rgba(61,128,115,0.10), transparent 70%);
    pointer-events: none;
  }
  .slab-kanji {
    position: absolute;
    top: 14px;
    right: 16px;
    font-family: var(--font-jp);
    font-size: 2.2rem;
    color: var(--jade-700);
    opacity: 0.18;
    line-height: 1;
    user-select: none;
  }
  .slab h3 {
    position: relative;
    margin: 0 0 var(--s-3);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--t-xl);
    color: var(--ink);
  }
  .slab-body {
    position: relative;
  }
  .slab-body :global(p) {
    color: var(--ink-soft);
    font-size: var(--t-md);
    line-height: 1.65;
    margin-bottom: var(--s-3);
  }
  .slab-body :global(p:last-child) { margin-bottom: 0; }

  .slab-brass {
    background:
      linear-gradient(160deg,
        color-mix(in oklab, var(--brass) 14%, var(--washi-bright)) 0%,
        var(--washi-bright) 70%);
    border-color: color-mix(in oklab, var(--brass) 30%, transparent);
  }
  .slab-brass .slab-kanji { color: var(--brass-deep); }

  .slab-ink {
    background:
      linear-gradient(160deg, #1a2520 0%, #0f1612 100%);
    border-color: rgba(141, 184, 171, 0.18);
    color: var(--washi-soft);
  }
  .slab-ink h3 { color: var(--washi-bright); }
  .slab-ink :global(p) { color: rgba(245, 239, 226, 0.82); }
  .slab-ink .slab-kanji { color: var(--jade-400); opacity: 0.28; }

  @media (prefers-color-scheme: dark) {
    .slab {
      background:
        linear-gradient(160deg, #0f1d18 0%, #0a1411 60%, #0f1d18 100%);
      border-color: rgba(141, 184, 171, 0.22);
    }
    .slab h3 { color: var(--ink); }
  }
</style>
